// Cấu hình ký (mục 19).
// Mặc định ký ad-hoc để build/chạy cục bộ. Bản phát hành: đặt DEVELOPMENT_TEAM và CODE_SIGN_IDENTITY = Developer ID Application
// trong Config/Signing.local.xcconfig (không commit). Lưu ý: helper (SMAppService.daemon) và yêu cầu chữ ký XPC hai chiều
// chỉ hoạt động đầy đủ khi ký bằng Team ID thật.
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
// Hardened runtime chỉ bật khi ký bằng Team ID thật (bắt buộc để notarize). Với chữ ký ad-hoc, hardened runtime
// bật kiểm tra thư viện: Sparkle.framework ký riêng sẽ bị dyld từ chối ("different Team IDs") và app chết khi mở.
ENABLE_HARDENED_RUNTIME = NO
OTHER_CODE_SIGN_FLAGS = --timestamp=none
// Ký ad-hoc không dùng được App Group `group.*` (cần provisioning profile): dùng entitlements không có app group.
// Bản ký Team ID đặt biến này rỗng trong Signing.local.xcconfig.
MASHCLEAN_ENTITLEMENTS_VARIANT = .adhoc

// Dịch vụ từ xa (để trống = tắt)
MASHCLEAN_RULES_MANIFEST_URL =
MASHCLEAN_ANALYTICS_URL =
MASHCLEAN_SUPPORT_EMAIL =
SPARKLE_FEED_URL =
SPARKLE_PUBLIC_ED_KEY =

#include? "Signing.local.xcconfig"
