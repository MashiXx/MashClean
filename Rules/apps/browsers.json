[
  {
    "id": "app.com.google.Chrome.leftovers",
    "version": 1,
    "category": "appLeftovers",
    "title": {
      "en": "Google Chrome leftovers",
      "vi": "File sót của Google Chrome"
    },
    "reason": {
      "en": "Settings, caches and support files Google Chrome leaves behind after the app is removed.",
      "vi": "Cài đặt, cache và tệp hỗ trợ Google Chrome để lại sau khi gỡ ứng dụng."
    },
    "safety": "review",
    "removal": "moveToTrash",
    "requiresRoot": false,
    "match": {
      "bundleIDs": [
        "com.google.Chrome"
      ],
      "paths": [
        "~/Library/Caches/${bundleID}",
        "~/Library/HTTPStorages/${bundleID}",
        "~/Library/WebKit/${bundleID}",
        "~/Library/Preferences/${bundleID}.plist",
        "~/Library/Saved Application State/${bundleID}.savedState",
        "~/Library/Application Scripts/${bundleID}",
        "~/Library/Containers/${bundleID}",
        "~/Library/Application Support/Google/Chrome",
        "~/Library/Caches/Google/Chrome"
      ]
    },
    "notes": "Application Support/Google/Chrome chứa hồ sơ (dấu trang, mật khẩu chưa đồng bộ) nên để review. Không đụng ~/Library/Google (GoogleSoftwareUpdate dùng chung)."
  },
