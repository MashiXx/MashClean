[
  {
    "id": "app.us.zoom.xos.leftovers",
    "version": 1,
    "category": "appLeftovers",
    "title": {
      "en": "Zoom leftovers",
      "vi": "File sót của Zoom"
    },
    "reason": {
      "en": "Settings, caches and support files Zoom leaves behind after the app is removed.",
      "vi": "Cài đặt, cache và tệp hỗ trợ Zoom để lại sau khi gỡ ứng dụng."
    },
    "safety": "safe",
    "removal": "moveToTrash",
    "requiresRoot": false,
    "match": {
      "bundleIDs": [
        "us.zoom.xos"
      ],
      "paths": [
        "~/Library/Caches/${bundleID}",
        "~/Library/HTTPStorages/${bundleID}",
        "~/Library/WebKit/${bundleID}",
        "~/Library/Preferences/${bundleID}.plist",
        "~/Library/Saved Application State/${bundleID}.savedState",
        "~/Library/Application Scripts/${bundleID}",
        "~/Library/Containers/${bundleID}",
        "~/Library/Application Support/zoom.us",
        "~/Library/Logs/zoom.us",
        "~/Library/Logs/zoominstall.log",
        "~/Library/Preferences/ZoomChat.plist",
        "~/Library/Preferences/us.zoom.ZoomAutoUpdater.plist",
        "~/Library/Internet Plug-Ins/ZoomUsPlugIn.plugin"
      ]
    },
    "notes": "Bản ghi cuộc họp nằm trong ~/Documents/Zoom: không thuộc rule này."
  },
