[
  {
    "id": "app.com.docker.docker.leftovers",
    "version": 1,
    "category": "appLeftovers",
    "title": {
      "en": "Docker Desktop leftovers",
      "vi": "File sót của Docker Desktop"
    },
    "reason": {
      "en": "Settings, caches and support files Docker Desktop leaves behind after the app is removed.",
      "vi": "Cài đặt, cache và tệp hỗ trợ Docker Desktop để lại sau khi gỡ ứng dụng."
    },
    "safety": "review",
    "removal": "moveToTrash",
    "requiresRoot": false,
    "match": {
      "bundleIDs": [
        "com.docker.docker"
      ],
      "paths": [
        "~/Library/Caches/${bundleID}",
        "~/Library/HTTPStorages/${bundleID}",
        "~/Library/WebKit/${bundleID}",
        "~/Library/Preferences/${bundleID}.plist",
        "~/Library/Saved Application State/${bundleID}.savedState",
        "~/Library/Application Scripts/${bundleID}",
        "~/Library/Containers/${bundleID}",
        "~/Library/Group Containers/group.com.docker",
        "~/Library/Application Support/Docker Desktop",
        "~/Library/Logs/Docker Desktop",
        "~/Library/Saved Application State/com.electron.docker-frontend.savedState",
        "~/Library/Preferences/com.electron.docker-frontend.plist",
        "~/.docker"
      ]
    },
    "notes": "~/Library/Containers/com.docker.docker chứa Docker.raw (image, volume): để review và chuyển vào Thùng rác."
  },
