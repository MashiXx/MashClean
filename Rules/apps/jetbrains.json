[
  {
    "id": "app.com.jetbrains.intellij.leftovers",
    "version": 1,
    "category": "appLeftovers",
    "title": {
      "en": "IntelliJ IDEA leftovers",
      "vi": "File sót của IntelliJ IDEA"
    },
    "reason": {
      "en": "Settings, caches and support files IntelliJ IDEA leaves behind after the app is removed.",
      "vi": "Cài đặt, cache và tệp hỗ trợ IntelliJ IDEA để lại sau khi gỡ ứng dụng."
    },
    "safety": "safe",
    "removal": "moveToTrash",
    "requiresRoot": false,
    "match": {
      "bundleIDs": [
        "com.jetbrains.intellij"
      ],
      "paths": [
        "~/Library/Caches/${bundleID}",
        "~/Library/HTTPStorages/${bundleID}",
        "~/Library/WebKit/${bundleID}",
        "~/Library/Preferences/${bundleID}.plist",
        "~/Library/Saved Application State/${bundleID}.savedState",
        "~/Library/Application Scripts/${bundleID}",
        "~/Library/Containers/${bundleID}",
        "~/Library/Application Support/JetBrains/IntelliJIdea*",
        "~/Library/Caches/JetBrains/IntelliJIdea*",
        "~/Library/Logs/JetBrains/IntelliJIdea*"
      ]
    },
    "notes": "Thư mục cấu hình theo phiên bản (<Product><năm.bản>) nằm chung trong ~/Library/*/JetBrains."
  },
