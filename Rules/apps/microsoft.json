  {
    "id": "app.com.microsoft.office.leftovers",
    "version": 1,
    "category": "appLeftovers",
    "title": {
      "en": "Microsoft Office (shared) leftovers",
      "vi": "File sót của Microsoft Office (dùng chung)"
    },
    "reason": {
      "en": "Data shared by all Microsoft Office apps, including Outlook's local mail cache. Only remove it when every Office app is uninstalled.",
      "vi": "Dữ liệu dùng chung của mọi app Microsoft Office, kể cả bộ đệm thư của Outlook. Chỉ xoá khi đã gỡ hết các app Office."
    },
    "safety": "review",
    "removal": "moveToTrash",
    "requiresRoot": false,
    "match": {
      "bundleIDs": [
        "com.microsoft.Word",
        "com.microsoft.Excel",
        "com.microsoft.Powerpoint",
        "com.microsoft.Outlook",
        "com.microsoft.onenote.mac"
      ],
      "paths": [
        "~/Library/Group Containers/UBF8T346G9.Office",
        "~/Library/Group Containers/UBF8T346G9.ms",
        "~/Library/Group Containers/UBF8T346G9.OfficeOsfWebHost",
        "~/Library/Group Containers/UBF8T346G9.com.microsoft.oneauth",
        "~/Library/Application Support/Microsoft/Office"
      ]
    },
    "exclude": [
      "~/Library/Group Containers/UBF8T346G9.OneDrive*"
    ],
    "notes": "Group Containers UBF8T346G9.* dùng chung cho cả bộ Office: chỉ xoá khi gỡ hết Office (Uninstaller phải kiểm tra không còn app nào khớp bundleIDs). Không bao giờ đụng UBF8T346G9.OneDrive* (dữ liệu đồng bộ OneDrive)."
  },
