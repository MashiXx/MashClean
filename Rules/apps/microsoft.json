[
  {
    "id": "app.com.microsoft.Word.leftovers",
    "version": 1,
    "category": "appLeftovers",
    "title": {
      "en": "Microsoft Word leftovers",
      "vi": "File sót của Microsoft Word"
    },
    "reason": {
      "en": "Settings, caches and support files Microsoft Word leaves behind after the app is removed.",
      "vi": "Cài đặt, cache và tệp hỗ trợ Microsoft Word để lại sau khi gỡ ứng dụng."
    },
    "safety": "review",
    "removal": "moveToTrash",
    "requiresRoot": false,
    "match": {
      "bundleIDs": [
        "com.microsoft.Word"
      ],
      "paths": [
        "~/Library/Caches/${bundleID}",
        "~/Library/HTTPStorages/${bundleID}",
        "~/Library/WebKit/${bundleID}",
        "~/Library/Preferences/${bundleID}.plist",
        "~/Library/Saved Application State/${bundleID}.savedState",
        "~/Library/Application Scripts/${bundleID}",
        "~/Library/Containers/${bundleID}"
      ]
    }
  },
