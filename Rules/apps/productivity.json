[
  {
    "id": "app.com.spotify.client.leftovers",
    "version": 1,
    "category": "appLeftovers",
    "title": {
      "en": "Spotify leftovers",
      "vi": "File sót của Spotify"
    },
    "reason": {
      "en": "Settings, caches and support files Spotify leaves behind after the app is removed.",
      "vi": "Cài đặt, cache và tệp hỗ trợ Spotify để lại sau khi gỡ ứng dụng."
    },
    "safety": "safe",
    "removal": "moveToTrash",
    "requiresRoot": false,
    "match": {
      "bundleIDs": [
        "com.spotify.client"
      ],
      "paths": [
        "~/Library/Caches/${bundleID}",
        "~/Library/HTTPStorages/${bundleID}",
        "~/Library/WebKit/${bundleID}",
        "~/Library/Preferences/${bundleID}.plist",
        "~/Library/Saved Application State/${bundleID}.savedState",
        "~/Library/Application Scripts/${bundleID}",
        "~/Library/Containers/${bundleID}",
        "~/Library/Application Support/Spotify",
        "~/Library/Caches/com.spotify.client.helper"
      ]
    }
  },
