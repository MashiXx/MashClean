  {
    "id": "devtools.pnpm.store",
    "version": 1,
    "category": "devToolCaches",
    "title": {
      "en": "pnpm store",
      "vi": "Kho gói pnpm"
    },
    "reason": {
      "en": "pnpm's content-addressable package store; projects re-link packages on the next install.",
      "vi": "Kho gói của pnpm; dự án sẽ liên kết lại gói ở lần cài kế tiếp."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
