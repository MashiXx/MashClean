[
  {
    "id": "devtools.homebrew.cache",
    "version": 1,
    "category": "devToolCaches",
    "title": {
      "en": "Homebrew downloads",
      "vi": "Bản tải về của Homebrew"
    },
    "reason": {
      "en": "Downloaded bottles and source archives; installed packages are not affected.",
      "vi": "Bottle và mã nguồn đã tải; không ảnh hưởng gói đã cài."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "~/Library/Caches/Homebrew"
      ]
    }
  },
  {
    "id": "devtools.npm.cache",
    "version": 1,
    "category": "devToolCaches",
    "title": {
      "en": "npm cache",
      "vi": "Cache của npm"
    },
    "reason": {
      "en": "Downloaded packages; npm re-downloads them when needed.",
      "vi": "Gói đã tải về; npm sẽ tự tải lại khi cần."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
