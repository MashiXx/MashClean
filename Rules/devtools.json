  {
    "id": "devtools.jetbrains.caches",
    "version": 1,
    "category": "devToolCaches",
    "title": {
      "en": "JetBrains IDE caches",
      "vi": "Cache IDE JetBrains"
    },
    "reason": {
      "en": "Indexes and caches of JetBrains IDEs; the IDE re-indexes projects on next start.",
      "vi": "Chỉ mục và cache của IDE JetBrains; IDE sẽ đánh chỉ mục lại ở lần mở sau."
