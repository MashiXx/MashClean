[
  {
    "id": "user.caches.all",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "Application caches",
      "vi": "Cache của ứng dụng"
    },
    "reason": {
      "en": "Temporary data apps keep to speed things up; they rebuild it automatically when needed.",
      "vi": "Dữ liệu tạm ứng dụng giữ để chạy nhanh hơn; ứng dụng tự tạo lại khi cần."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "~/Library/Caches/*"
      ]
    },
    "exclude": [
      "~/Library/Caches/com.apple.*",
      "~/Library/Caches/CloudKit",
      "~/Library/Caches/Metadata",
      "~/Library/Caches/GeoServices",
      "~/Library/Caches/FamilyCircle",
      "~/Library/Caches/familycircled",
      "~/Library/Caches/sharedfilelistd",
      "~/Library/Caches/storeassetd",
      "~/Library/Caches/TemporaryItems",
      "~/Library/Caches/MashClean",
      "~/Library/Caches/com.cleanboost.*",
      "~/Library/Caches/Homebrew",
      "~/Library/Caches/Yarn",
      "~/Library/Caches/pnpm",
      "~/Library/Caches/pip",
      "~/Library/Caches/pypoetry",
      "~/Library/Caches/CocoaPods",
      "~/Library/Caches/org.carthage.CarthageKit",
      "~/Library/Caches/org.swift.swiftpm",
      "~/Library/Caches/go-build",
      "~/Library/Caches/JetBrains",
      "~/Library/Caches/deno",
      "~/Library/Caches/ms-playwright",
      "~/Library/Caches/node-gyp",
      "~/Library/Caches/typescript"
    ],
    "notes": "Mục lá là từng thư mục con của ~/Library/Caches; cache của Apple và cache công cụ lập trình đã có rule riêng nên loại trừ ở đây."
  },
  {
    "id": "app.generic.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "App caches",
      "vi": "Cache theo ứng dụng"
    },
    "reason": {
      "en": "Cache folders that belong to an installed app; the app recreates them on next launch.",
      "vi": "Thư mục cache của một ứng dụng đã cài; ứng dụng sẽ tạo lại ở lần mở sau."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "forEachInstalledApp": true,
      "paths": [
        "~/Library/Caches/${bundleID}",
        "~/Library/Containers/${bundleID}/Data/Library/Caches"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "${bundleID}"
      ]
    },
    "exclude": [
      "~/Library/Caches/com.apple.*",
      "~/Library/Containers/com.apple.*",
      "~/Library/Caches/CloudKit",
      "~/Library/Caches/com.cleanboost.*",
      "~/Library/Containers/com.cleanboost.*"
    ]
  },
  {
    "id": "user.httpStorages",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "HTTP storage of apps",
      "vi": "Bộ nhớ HTTP của ứng dụng"
    },
    "reason": {
      "en": "Network cookies and HTTP caches of apps that are not running; you may need to sign in again in some apps.",
      "vi": "Cookie và cache HTTP của ứng dụng không chạy; một số ứng dụng có thể yêu cầu đăng nhập lại."
    },
    "safety": "review",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "forEachInstalledApp": true,
      "paths": [
        "~/Library/HTTPStorages/${bundleID}"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "${bundleID}"
      ]
    },
    "exclude": [
      "~/Library/HTTPStorages/com.apple.*",
      "~/Library/HTTPStorages/com.cleanboost.*"
    ]
  },
  {
    "id": "browser.chrome.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "Google Chrome cache",
      "vi": "Cache Google Chrome"
    },
    "reason": {
      "en": "Cached web pages and scripts; history, passwords and bookmarks are not touched.",
      "vi": "Trang web và script đã lưu tạm; không đụng tới lịch sử, mật khẩu, dấu trang."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "~/Library/Caches/Google/Chrome/*/Cache",
        "~/Library/Caches/Google/Chrome/*/Code Cache",
        "~/Library/Application Support/Google/Chrome/*/GPUCache",
        "~/Library/Application Support/Google/Chrome/*/Service Worker/CacheStorage",
        "~/Library/Application Support/Google/Chrome/ShaderCache",
        "~/Library/Application Support/Google/Chrome/GrShaderCache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "com.google.Chrome"
      ]
    }
  },
  {
    "id": "browser.firefox.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "Firefox cache",
      "vi": "Cache Firefox"
    },
    "reason": {
      "en": "Firefox's disk cache of web content; profiles and saved data are kept.",
      "vi": "Cache nội dung web của Firefox; hồ sơ và dữ liệu đã lưu được giữ nguyên."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "~/Library/Caches/Firefox/Profiles/*/cache2"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "org.mozilla.firefox"
      ]
    }
  },
