  {
    "id": "electron.slack.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "Slack cache",
      "vi": "Cache Slack"
    },
    "reason": {
      "en": "Slack's web cache; messages stay on Slack's servers.",
      "vi": "Cache web của Slack; tin nhắn vẫn nằm trên máy chủ Slack."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "~/Library/Application Support/Slack/Cache",
        "~/Library/Application Support/Slack/Code Cache",
        "~/Library/Application Support/Slack/GPUCache",
        "~/Library/Application Support/Slack/Service Worker/CacheStorage",
        "~/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack/Cache",
        "~/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack/Service Worker/CacheStorage"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "com.tinyspeck.slackmacgap"
      ]
    }
  },
  {
    "id": "electron.discord.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "Discord cache",
      "vi": "Cache Discord"
    },
    "reason": {
      "en": "Discord's downloaded images and web cache; they download again when needed.",
      "vi": "Ảnh và cache web Discord đã tải; sẽ tải lại khi cần."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "~/Library/Application Support/discord/Cache",
        "~/Library/Application Support/discord/Code Cache",
        "~/Library/Application Support/discord/GPUCache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "com.hnc.Discord"
      ]
    }
  },
  {
    "id": "electron.teams.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "Microsoft Teams cache",
      "vi": "Cache Microsoft Teams"
    },
    "reason": {
      "en": "Teams' web cache; chats and files stay in the cloud.",
      "vi": "Cache web của Teams; tin nhắn và tệp vẫn nằm trên đám mây."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "~/Library/Containers/com.microsoft.teams2/Data/Library/Caches",
        "~/Library/Application Support/Microsoft/Teams/Cache",
        "~/Library/Application Support/Microsoft/Teams/Code Cache",
        "~/Library/Application Support/Microsoft/Teams/GPUCache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "com.microsoft.teams2",
        "com.microsoft.teams"
      ]
    }
  },
  {
    "id": "media.spotify.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "en": "Spotify streaming cache",
      "vi": "Cache phát nhạc Spotify"
    },
    "reason": {
      "en": "Temporarily stored songs for streaming; downloaded playlists for offline use are kept.",
      "vi": "Bài hát lưu tạm khi nghe trực tuyến; danh sách đã tải để nghe ngoại tuyến được giữ."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "~/Library/Caches/com.spotify.client/Data"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "com.spotify.client"
      ]
    },
    "notes": "Không đụng ~/Library/Application Support/Spotify/PersistentCache: Spotify lưu bài hát tải để nghe ngoại tuyến ở đó."
  }
]
