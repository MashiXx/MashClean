        "~/Library/Caches/CocoaPods",
        "~/Library/Caches/org.carthage.CarthageKit",
        "~/Library/Caches/org.swift.swiftpm"
      ]
    },
    {
      "name": "Go build cache và Cargo",
      "rules": ["devtools.go.buildCache", "devtools.cargo.registryCache"],
      "files": [
        { "path": "~/Library/Caches/go-build/0a/x-d", "size": 4096 },
        { "path": "~/.cargo/registry/cache/index.crates.io-6f17d22bba15001f/serde-1.0.0.crate", "size": 4096 },
