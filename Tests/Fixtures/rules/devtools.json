{
  "cases": [
    {
      "name": "npm: _cacache, _logs, _npx; không đụng cấu hình",
      "rules": ["devtools.npm.cache"],
      "files": [
        { "path": "~/.npm/_cacache/index-v5/aa/bb", "size": 4096 },
        { "path": "~/.npm/_cacache/content-v2/sha512/cc", "size": 8192 },
        { "path": "~/.npm/_logs/2026-10-01-debug.log", "size": 1024 },
        { "path": "~/.npmrc", "size": 100 }
      ],
      "expect": ["~/.npm/_cacache", "~/.npm/_logs"]
    },
    {
      "name": "Yarn, pnpm, Bun, Deno, node-gyp, Playwright",
      "rules": ["devtools.yarn.cache", "devtools.pnpm.store", "devtools.bun.cache", "devtools.deno.cache", "devtools.nodeTools.cache", "devtools.playwright.browsers"],
      "files": [
        { "path": "~/Library/Caches/Yarn/v6/npm-left-pad/x", "size": 4096 },
        { "path": "~/Library/pnpm/store/v3/files/00/x", "size": 4096 },
        { "path": "~/.bun/install/cache/react@18/x", "size": 4096 },
        { "path": "~/Library/Caches/deno/deps/https/x", "size": 4096 },
        { "path": "~/Library/Caches/node-gyp/20.0.0/include/node.h", "size": 4096 },
        { "path": "~/Library/Caches/ms-playwright/chromium-1100/x", "size": 4096 }
      ],
      "expect": [
        "~/Library/Caches/Yarn",
        "~/Library/pnpm/store",
        "~/.bun/install/cache",
        "~/Library/Caches/deno",
        "~/Library/Caches/node-gyp",
        "~/Library/Caches/ms-playwright"
      ]
    },
    {
      "name": "Python: pip, Poetry (giữ virtualenvs), uv",
      "rules": ["devtools.pip.cache", "devtools.poetry.cache", "devtools.uv.cache"],
      "files": [
        { "path": "~/Library/Caches/pip/http-v2/a/b", "size": 4096 },
        { "path": "~/Library/Caches/pypoetry/cache/repositories/PyPI/x", "size": 4096 },
        { "path": "~/Library/Caches/pypoetry/artifacts/aa/x.whl", "size": 4096 },
