    },
    {
      "name": "JetBrains, VS Code, Cursor",
      "rules": ["devtools.jetbrains.caches", "devtools.vscode.caches", "devtools.cursor.caches"],
      "files": [
        { "path": "~/Library/Caches/JetBrains/IntelliJIdea2024.1/caches/x", "size": 4096 },
        { "path": "~/Library/Caches/JetBrains/PyCharm2024.1/index/x", "size": 4096 },
        { "path": "~/Library/Application Support/Code/CachedData/abc/x", "size": 4096 },
        { "path": "~/Library/Application Support/Code/CachedExtensionVSIXs/ms-python.python-1.0", "size": 4096 },
        { "path": "~/Library/Application Support/Code/User/settings.json", "size": 100 },
        { "path": "~/Library/Application Support/Cursor/CachedData/abc/x", "size": 4096 }
      ],
      "expect": [
        "~/Library/Caches/JetBrains/IntelliJIdea2024.1",
        "~/Library/Caches/JetBrains/PyCharm2024.1",
        "~/Library/Application Support/Code/CachedData",
        "~/Library/Application Support/Code/CachedExtensionVSIXs",
        "~/Library/Application Support/Cursor/CachedData"
      ]
    },
    {
      "name": "JetBrains đang chạy: bỏ qua cache IDE",
      "rules": ["devtools.jetbrains.caches"],
      "running": ["com.jetbrains.intellij"],
      "files": [{ "path": "~/Library/Caches/JetBrains/IntelliJIdea2024.1/caches/x", "size": 4096 }],
      "expect": []
    }
  ]
}
