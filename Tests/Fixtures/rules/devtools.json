        "~/Library/Caches/pypoetry/cache",
        "~/Library/Caches/pypoetry/artifacts",
        "~/.cache/uv"
      ]
    },
    {
      "name": "JVM: Gradle, Maven, Android",
      "rules": ["devtools.gradle.caches", "devtools.maven.repository", "devtools.androidStudio.caches"],
      "files": [
        { "path": "~/.gradle/caches/modules-2/files-2.1/x.jar", "size": 8192 },
        { "path": "~/.gradle/wrapper/dists/gradle-8.5-bin/x.zip", "size": 4096 },
