      ],
      "expect": ["~/.gradle/caches", "~/.gradle/wrapper/dists", "~/.m2/repository", "~/.android/build-cache"]
    },
    {
      "name": "Apple: Homebrew, CocoaPods, Carthage, SwiftPM",
      "rules": ["devtools.homebrew.cache", "devtools.cocoapods.cache", "devtools.carthage.cache", "devtools.swiftpm.cache"],
      "files": [
        { "path": "~/Library/Caches/Homebrew/downloads/abc--wget.bottle.tar.gz", "size": 8192 },
        { "path": "~/Library/Caches/Homebrew/wget--1.21.bottle.tar.gz", "symlink": "~/Library/Caches/Homebrew/downloads/abc--wget.bottle.tar.gz" },
        { "path": "~/Library/Caches/CocoaPods/Pods/Release/x", "size": 4096 },
