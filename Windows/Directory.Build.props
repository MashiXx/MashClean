<Project>
  <!-- Thiết lập chung cho mọi project của bản Windows (xem docs/WINDOWS_DESIGN.md). -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;vi</SatelliteResourceLanguages>

    <Version>1.0.0</Version>
    <Company>Clean Boost</Company>
    <Product>Clean Boost</Product>
    <Copyright>© 2026 Clean Boost</Copyright>

    <!-- Build ra ngoài thư mục mã nguồn. CB_BUILD_SLOT cho phép nhiều tiến trình build song song không giẫm lên nhau. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts$(CB_BUILD_SLOT)</ArtifactsPath>

    <NoWarn>$(NoWarn);CA1416;WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
</Project>
