[
  {
    "id": "devtools.npm.cache",
    "version": 1,
    "category": "devToolCaches",
    "title": {
      "vi": "Cache của npm",
      "en": "npm cache"
    },
    "reason": {
      "vi": "Gói đã tải về và gói npx tạm; npm sẽ tự tải lại khi cần. Gói cài toàn cục không bị ảnh hưởng.",
      "en": "Downloaded packages and temporary npx packages; npm downloads them again when needed. Globally installed packages are not affected."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%LOCALAPPDATA%\\npm-cache\\_cacache",
        "%LOCALAPPDATA%\\npm-cache\\_npx",
        "%APPDATA%\\npm-cache\\_cacache",
        "%APPDATA%\\npm-cache\\_npx"
      ]
    },
    "notes": "Không đụng %APPDATA%\\npm (gói cài toàn cục)."
  },
