        "Battle.net"
      ]
    }
  },
  {
    "id": "app.adobe.media-cache",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Media cache của Adobe",
      "en": "Adobe media cache"
    },
    "reason": {
      "vi": "Âm thanh đã chuyển đổi và dạng sóng Premiere Pro, After Effects, Media Encoder tạo ra; được tạo lại khi mở dự án nhưng có thể mất nhiều thời gian.",
      "en": "Conformed audio and waveform files created by Premiere Pro, After Effects and Media Encoder; they are rebuilt when projects open, which can take a while."
    },
    "safety": "review",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%APPDATA%\\Adobe\\Common\\Media Cache Files",
        "%APPDATA%\\Adobe\\Common\\Media Cache",
        "%APPDATA%\\Adobe\\Common\\Peak Files"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "Adobe Premiere Pro",
        "AfterFX",
        "Adobe Media Encoder",
        "Adobe Audition",
        "Adobe Premiere Rush"
      ]
    },
    "notes": "Để review vì dựng lại cache cho dự án lớn rất lâu; người dùng có thể đã đổi vị trí cache trong Preferences (khi đó rule không thấy gì)."
  },
  {
    "id": "app.adobe.camera-raw-cache",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache Camera Raw",
      "en": "Camera Raw cache"
    },
    "reason": {
      "vi": "Bản xem trước ảnh RAW do Camera Raw tạo cho Photoshop, Bridge, Lightroom; được tạo lại khi mở ảnh.",
      "en": "RAW previews Camera Raw created for Photoshop, Bridge and Lightroom; they are regenerated when photos are opened."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%LOCALAPPDATA%\\Adobe\\CameraRaw\\Cache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "Photoshop",
        "Lightroom",
        "Adobe Bridge"
      ]
    }
  },
  {
    "id": "app.telegram.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache Telegram Desktop",
      "en": "Telegram Desktop cache"
    },
    "reason": {
      "vi": "Ảnh, video và tệp Telegram đã tải khi xem tin nhắn; được tải lại từ đám mây khi cần. Phiên đăng nhập được giữ.",
      "en": "Photos, videos and files Telegram downloaded while you read chats; they are downloaded again from the cloud. Your session is kept."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%APPDATA%\\Telegram Desktop\\tdata\\user_data*\\cache",
        "%APPDATA%\\Telegram Desktop\\tdata\\user_data*\\media_cache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "telegram"
      ]
    },
    "notes": "user_data* khớp cả tài khoản phụ (user_data#2...). Không đụng các file khác trong tdata (khoá phiên đăng nhập)."
  },
  {
