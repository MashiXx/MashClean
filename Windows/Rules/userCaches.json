[
  {
    "id": "app.generic.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache theo ứng dụng",
      "en": "App caches"
    },
    "reason": {
      "vi": "Thư mục cache của một ứng dụng đã cài; ứng dụng sẽ tạo lại ở lần mở sau.",
      "en": "Cache folders that belong to an installed app; the app recreates them on next launch."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "forEachInstalledApp": true,
      "paths": [
        "%LOCALAPPDATA%\\${appName}\\Cache",
        "%LOCALAPPDATA%\\${appName}\\Code Cache",
        "%LOCALAPPDATA%\\${appName}\\GPUCache",
        "%APPDATA%\\${appName}\\Cache",
        "%APPDATA%\\${appName}\\Code Cache",
        "%APPDATA%\\${appName}\\GPUCache",
        "%LOCALAPPDATA%\\${publisher}\\${appName}\\Cache",
        "%LOCALAPPDATA%\\${publisher}\\${appName}\\Code Cache",
        "%LOCALAPPDATA%\\${publisher}\\${appName}\\GPUCache",
        "%APPDATA%\\${publisher}\\${appName}\\Cache",
        "%APPDATA%\\${publisher}\\${appName}\\Code Cache",
        "%APPDATA%\\${publisher}\\${appName}\\GPUCache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "${appID}"
      ]
    },
    "exclude": [
      "%LOCALAPPDATA%\\CleanBoost",
      "%APPDATA%\\CleanBoost",
      "%LOCALAPPDATA%\\Microsoft",
      "%APPDATA%\\Microsoft",
      "%LOCALAPPDATA%\\Packages",
      "%LOCALAPPDATA%\\Temp"
    ],
    "notes": "App của nhà phát hành hệ thống (Microsoft) bị bỏ qua trước khi mở rộng biến. Biến ${publisher} có dấu chấm cuối (vd 'Discord Inc.') làm mẫu đó bị bỏ qua, các mẫu còn lại vẫn áp dụng."
  },
  {
    "id": "electron.discord.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache Discord",
      "en": "Discord cache"
    },
    "reason": {
      "vi": "Ảnh và cache web Discord đã tải; sẽ tải lại khi cần, tin nhắn vẫn nằm trên máy chủ.",
      "en": "Images and web caches Discord downloaded; they are fetched again when needed and messages stay on Discord's servers."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%APPDATA%\\discord*\\Cache",
        "%APPDATA%\\discord*\\Code Cache",
        "%APPDATA%\\discord*\\GPUCache",
        "%APPDATA%\\discord*\\DawnCache",
        "%APPDATA%\\discord*\\DawnGraphiteCache",
        "%APPDATA%\\discord*\\DawnWebGPUCache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "discord",
        "discordptb",
        "discordcanary"
      ]
    },
    "notes": "discord* khớp cả Discord PTB (discordptb) và Canary (discordcanary)."
  },
  {
    "id": "electron.slack.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache Slack",
      "en": "Slack cache"
    },
    "reason": {
      "vi": "Cache web của Slack; tin nhắn vẫn nằm trên máy chủ Slack.",
      "en": "Slack's web cache; messages stay on Slack's servers."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%APPDATA%\\Slack\\Cache",
        "%APPDATA%\\Slack\\Code Cache",
        "%APPDATA%\\Slack\\GPUCache",
        "%APPDATA%\\Slack\\DawnCache",
        "%APPDATA%\\Slack\\DawnGraphiteCache",
        "%APPDATA%\\Slack\\DawnWebGPUCache",
        "%APPDATA%\\Slack\\Service Worker\\CacheStorage",
        "%LOCALAPPDATA%\\Packages\\91750D7E.Slack_*\\LocalCache\\Roaming\\Slack\\Cache",
        "%LOCALAPPDATA%\\Packages\\91750D7E.Slack_*\\LocalCache\\Roaming\\Slack\\Code Cache",
        "%LOCALAPPDATA%\\Packages\\91750D7E.Slack_*\\LocalCache\\Roaming\\Slack\\GPUCache",
        "%LOCALAPPDATA%\\Packages\\91750D7E.Slack_*\\LocalCache\\Roaming\\Slack\\Service Worker\\CacheStorage"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "slack"
      ]
    },
    "notes": "Gồm bản Microsoft Store (gói 91750D7E.Slack, dữ liệu ảo hoá trong LocalCache\\Roaming)."
  },
  {
    "id": "electron.teams.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache Microsoft Teams",
      "en": "Microsoft Teams cache"
    },
    "reason": {
      "vi": "Cache web của Teams; tin nhắn và tệp vẫn nằm trên đám mây.",
      "en": "Teams' web cache; chats and files stay in the cloud."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%APPDATA%\\Microsoft\\Teams\\Cache",
        "%APPDATA%\\Microsoft\\Teams\\Code Cache",
        "%APPDATA%\\Microsoft\\Teams\\GPUCache",
        "%APPDATA%\\Microsoft\\Teams\\Service Worker\\CacheStorage",
        "%APPDATA%\\Microsoft\\Teams\\application cache\\Cache",
        "%APPDATA%\\Microsoft\\Teams\\tmp",
        "%LOCALAPPDATA%\\Packages\\MSTeams_*\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\*\\Cache",
        "%LOCALAPPDATA%\\Packages\\MSTeams_*\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\*\\Code Cache",
        "%LOCALAPPDATA%\\Packages\\MSTeams_*\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\*\\GPUCache",
        "%LOCALAPPDATA%\\Packages\\MSTeams_*\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\*\\Service Worker\\CacheStorage",
        "%LOCALAPPDATA%\\Packages\\MSTeams_*\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\ShaderCache",
        "%LOCALAPPDATA%\\Packages\\MSTeams_*\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\GrShaderCache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "teams",
        "ms-teams"
      ]
    },
    "notes": "Teams cổ điển (%APPDATA%\\Microsoft\\Teams) và Teams mới (gói MSTeams, WebView2 trong EBWebView). Không đụng IndexedDB, Local Storage, blob_storage (trạng thái đăng nhập)."
  },
  {
    "id": "media.spotify.caches",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache phát nhạc Spotify",
      "en": "Spotify streaming cache"
    },
    "reason": {
      "vi": "Bài hát lưu tạm khi nghe trực tuyến và cache giao diện; nhạc đã tải để nghe ngoại tuyến được giữ.",
      "en": "Songs cached while streaming and the app's web cache; music downloaded for offline listening is kept."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%LOCALAPPDATA%\\Spotify\\Data",
        "%LOCALAPPDATA%\\Spotify\\Browser\\Cache",
        "%LOCALAPPDATA%\\Packages\\SpotifyAB.SpotifyMusic_*\\LocalCache\\Spotify\\Data"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "spotify"
      ]
    },
    "notes": "Spotify\\Storage là vị trí lưu nhạc ngoại tuyến mặc định nên tách sang rule review riêng."
  },
  {
    "id": "media.spotify.offline",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Bộ nhớ ngoại tuyến của Spotify",
      "en": "Spotify offline storage"
    },
    "reason": {
      "vi": "Có thể chứa bài hát, podcast bạn đã tải để nghe khi không có mạng; xoá thì phải tải lại trong Spotify.",
      "en": "May contain songs and podcasts you downloaded for offline listening; you will need to download them again in Spotify."
    },
    "safety": "review",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%LOCALAPPDATA%\\Spotify\\Storage",
        "%LOCALAPPDATA%\\Packages\\SpotifyAB.SpotifyMusic_*\\LocalCache\\Spotify\\Storage"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "spotify"
      ]
    }
  },
  {
    "id": "app.steam.web-cache",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache trình duyệt của Steam",
      "en": "Steam web cache"
    },
    "reason": {
      "vi": "Trang cửa hàng, ảnh và cache web của giao diện Steam; game và dữ liệu lưu không bị ảnh hưởng.",
      "en": "Store pages, images and web cache of the Steam client; games and saves are not affected."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%LOCALAPPDATA%\\Steam\\htmlcache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "steam",
        "steamwebhelper"
      ]
    }
  },
  {
    "id": "app.steam.app-cache",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache HTTP của Steam",
      "en": "Steam HTTP cache"
    },
    "reason": {
      "vi": "Ảnh và dữ liệu cửa hàng Steam tải về trong thư mục cài đặt; Steam tải lại khi cần.",
      "en": "Store images and data Steam downloaded into its install folder; Steam downloads them again when needed."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": true,
    "match": {
      "paths": [
        "%PROGRAMFILES(X86)%\\Steam\\appcache\\httpcache",
        "%PROGRAMFILES(X86)%\\Steam\\htmlcache"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "steam",
        "steamwebhelper"
      ]
    },
    "notes": "Thư mục Steam thường cho người dùng ghi; requiresRoot vì nằm trong Program Files (x86), PathPolicy chuyển helper khi cần. Steam cài ở thư viện khác không được tìm thấy."
  },
  {
    "id": "app.steam.shader-cache",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache shader game Steam",
      "en": "Steam game shader cache"
    },
    "reason": {
      "vi": "Shader đã biên dịch sẵn cho từng game Steam (thư mục theo mã game). Xoá thì game phải biên dịch hoặc tải lại shader, lần chơi đầu có thể giật.",
      "en": "Precompiled shaders for each Steam game (one folder per game ID). Games have to rebuild or redownload them, so the first session may stutter."
    },
    "safety": "review",
    "removal": "delete",
    "requiresRoot": true,
    "match": {
      "paths": [
        "%PROGRAMFILES(X86)%\\Steam\\steamapps\\shadercache\\*"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "steam"
      ]
    }
  },
  {
    "id": "app.epic.web-cache",
    "version": 1,
    "category": "userCaches",
    "title": {
      "vi": "Cache web của Epic Games Launcher",
      "en": "Epic Games Launcher web cache"
    },
    "reason": {
      "vi": "Cache trang cửa hàng của Epic Games Launcher; game đã cài không bị ảnh hưởng.",
      "en": "Store page cache of the Epic Games Launcher; installed games are not affected."
    },
    "safety": "safe",
    "removal": "deleteContents",
    "requiresRoot": false,
    "match": {
      "paths": [
        "%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\webcache*"
      ]
    },
    "conditions": {
      "appNotRunning": [
        "EpicGamesLauncher",
        "EpicWebHelper"
      ]
    },
    "notes": "webcache* khớp webcache, webcache_4147, webcache_4430... theo phiên bản CEF."
  },
  {
