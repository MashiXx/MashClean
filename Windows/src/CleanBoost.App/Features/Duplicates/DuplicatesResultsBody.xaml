<UserControl x:Class="CleanBoost.App.Features.Duplicates.DuplicatesResultsBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CleanBoost.App.Features.Duplicates"
             xmlns:files="clr-namespace:CleanBoost.App.Features.LargeOldFiles"
             Foreground="White" FontFamily="{StaticResource TextFont}">
    <UserControl.Resources>
        <!-- Dòng nhóm: bo 8, nhóm đang xem nền trắng 0.16 (như bản Mac) -->
        <Style x:Key="GroupItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#29FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FileItem" TargetType="ListBoxItem" BasedOn="{StaticResource GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Trái: danh sách nhóm -->
            <Border CornerRadius="14" Background="#2E000000">
                <ListBox x:Name="GroupList" Background="Transparent" BorderThickness="0" Margin="6" Foreground="White"
                         ItemContainerStyle="{StaticResource GroupItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="OnGroupFocused" KeyDown="OnGroupKeyDown">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" CanContentScroll="True">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DuplicateGroupRow}">
                            <Grid Margin="8,7" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <files:SelectionCheck Style="{StaticResource TriCheck}" IsChecked="{Binding IsChecked, Mode=OneWay}" Toggled="OnGroupCheck" Margin="0,0,10,0" />
                                <Image Grid.Column="1" Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="2" Margin="9,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding WastedText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"
                                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Phải: chi tiết nhóm đang xem -->
            <Border Grid.Column="2" CornerRadius="14" Background="#2E000000" Padding="16,14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="140" Height="140" CornerRadius="10" Background="#33000000" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="ThumbPlaceholder" FontFamily="{StaticResource IconFont}" FontSize="64" Foreground="#D9FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="Thumb" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,4,0,0">
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource HeadlineText}" FontSize="17" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailSubtitle" Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,5,0,0" />
                            <TextBlock x:Name="DetailWasted" Style="{StaticResource CaptionText}" FontSize="12.5" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="White" SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource FileItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             KeyDown="OnFileKeyDown" MouseDoubleClick="OnFileDoubleClick">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False" CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DuplicateFileRow}">
                                <Grid Margin="8,6" Background="Transparent" ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="800">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <files:SelectionCheck Style="{StaticResource TriCheck}" IsChecked="{Binding IsChecked, Mode=OneWay}" Toggled="OnFileCheck" Margin="0,0,12,0" />
                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="2" Margin="10,0,12,0" VerticalAlignment="Center">
                                        <files:InlineRow Spacing="7">
                                            <files:MiddleTrimmedText files:InlineRow.Shrink="True" Text="{Binding Title}" FontSize="13" FontWeight="Medium" />
                                            <Border Style="{StaticResource PillBorder}" Background="#334CD964" Visibility="{Binding KeepVisibility}">
                                                <TextBlock Text="{Binding KeepLabel}" Style="{StaticResource PillText}" Foreground="{StaticResource SafeBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource PillBorder}" Background="#33FFCC00" Visibility="{Binding LinkedVisibility}" ToolTip="{Binding LinkedTooltip}">
                                                <TextBlock Text="Hard link" Style="{StaticResource PillText}" Foreground="{StaticResource ReviewBrush}" />
                                            </Border>
                                        </files:InlineRow>
                                        <files:MiddleTrimmedText Text="{Binding FolderText}" FontSize="11.5" Foreground="{StaticResource TertiaryText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding DateText}" FontSize="12" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <ContentPresenter x:Name="FooterHost" Grid.Row="1" />
    </Grid>
</UserControl>
