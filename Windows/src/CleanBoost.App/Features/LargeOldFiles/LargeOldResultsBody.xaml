<UserControl x:Class="CleanBoost.App.Features.LargeOldFiles.LargeOldResultsBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CleanBoost.App.Features.LargeOldFiles"
             Foreground="White" FontFamily="{StaticResource TextFont}">
    <UserControl.Resources>
        <!-- Nút lọc dạng menu (giống DarkComboBox) -->
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="#29FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="12,0,10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tiêu đề cột bấm được để sắp xếp -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dòng bảng: sọc xen kẽ như bảng tối của bản Mac -->
        <Style x:Key="TableRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#17FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thanh lọc: loại, dung lượng, thời gian, thư mục, tìm theo tên -->
        <WrapPanel x:Name="FilterBar" Orientation="Horizontal">
            <Button x:Name="KindButton" Style="{StaticResource FilterButton}" MinWidth="110" MaxWidth="200" Margin="0,0,10,6" Click="OnKindMenu">
                <TextBlock x:Name="KindText" TextTrimming="CharacterEllipsis" />
            </Button>
            <ComboBox x:Name="SizeCombo" Style="{StaticResource DarkComboBox}" Width="150" Height="30" Margin="0,0,10,6" SelectionChanged="OnFilterChanged" />
            <ComboBox x:Name="AgeCombo" Style="{StaticResource DarkComboBox}" Width="180" Height="30" Margin="0,0,10,6" SelectionChanged="OnFilterChanged" />
            <ComboBox x:Name="FolderCombo" Style="{StaticResource DarkComboBox}" Width="170" Height="30" Margin="0,0,10,6" SelectionChanged="OnFilterChanged" />
            <Grid Width="200" Height="30" Margin="0,0,0,6">
                <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="26,0,8,0" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource TertiaryText}"
                           VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchPlaceholder" FontSize="13" Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center"
                           Margin="28,0,0,0" IsHitTestVisible="False" />
            </Grid>
        </WrapPanel>

        <!-- Bảng -->
        <Border Grid.Row="1" CornerRadius="12" Background="#40000000" Margin="0,6,0,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                    <Grid x:Name="HeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="5*" MinWidth="160" />
                            <ColumnDefinition Width="4*" MinWidth="110" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="152" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NameHeader" Grid.Column="1" Style="{StaticResource HeaderButton}" Click="OnSortName" />
                        <Button x:Name="FolderHeader" Grid.Column="2" Style="{StaticResource HeaderButton}" Click="OnSortFolder" />
                        <Button x:Name="SizeHeader" Grid.Column="3" Style="{StaticResource HeaderButton}" Click="OnSortSize" />
                        <Button x:Name="DateHeader" Grid.Column="4" Style="{StaticResource HeaderButton}" Click="OnSortDate" />
                        <Button x:Name="KindHeader" Grid.Column="5" Style="{StaticResource HeaderButton}" Click="OnSortKind" />
                    </Grid>
                </Border>
                <ListBox x:Name="Table" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Foreground="White"
                         ItemContainerStyle="{StaticResource TableRow}" AlternationCount="2" SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         KeyDown="OnTableKeyDown" MouseDoubleClick="OnTableDoubleClick">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer x:Name="Scroller" Focusable="False" Padding="0" CanContentScroll="True">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LargeOldRow}">
                            <Grid Height="30" Background="Transparent" ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="800">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="5*" MinWidth="160" />
                                    <ColumnDefinition Width="4*" MinWidth="110" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="152" />
                                </Grid.ColumnDefinitions>
                                <local:SelectionCheck Style="{StaticResource SquareCheck}" HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=OneWay}" Toggled="OnRowCheck" />
                                <local:InlineRow Grid.Column="1" Margin="8,0" Spacing="7">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <local:MiddleTrimmedText local:InlineRow.Shrink="True" Text="{Binding Name}" FontSize="13" />
                                    <Border Style="{StaticResource PillBorder}" Visibility="{Binding HiddenVisibility}">
                                        <TextBlock Text="{Binding HiddenLabel}" Style="{StaticResource PillText}" />
                                    </Border>
                                </local:InlineRow>
                                <local:MiddleTrimmedText Grid.Column="2" Margin="8,0" Text="{Binding FolderText}" FontSize="12.5" Foreground="{StaticResource SecondaryText}" />
                                <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding SizeText}" FontSize="13" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Grid.Column="4" Margin="8,0" Text="{Binding DateText}" FontSize="13" VerticalAlignment="Center" Foreground="{Binding DateBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Margin="8,0" Text="{Binding KindText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoMatchText" Grid.Row="1" Style="{StaticResource SecondaryBodyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <ContentPresenter x:Name="FooterHost" Grid.Row="2" />
    </Grid>
</UserControl>
