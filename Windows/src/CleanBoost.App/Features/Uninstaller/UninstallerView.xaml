<UserControl x:Class="CleanBoost.App.Features.Uninstaller.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CleanBoost.App.UI"
             xmlns:shared="clr-namespace:CleanBoost.App.Shared"
             xmlns:local="clr-namespace:CleanBoost.App.Features.Uninstaller"
             Foreground="White" FontFamily="{StaticResource TextFont}">
    <UserControl.Resources>
        <!-- Nút của điều khiển phân đoạn (Picker .segmented của bản Mac) -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegmentSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="SegmentSelected" Color="#FF2F6FE8" />

        <!-- Thẻ số liệu (StatTile) -->
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type local:AppRow}">
            <Grid Margin="8,6,10,6" Background="Transparent" ToolTipService.InitialShowDelay="800">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource TriCheck}" IsThreeState="False" IsChecked="{Binding IsChecked, Mode=OneWay}" Click="OnRowCheck"
                          Visibility="{Binding CanUninstall, Converter={StaticResource Visible}}" />
                <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource TertiaryText}" HorizontalAlignment="Left"
                           Margin="2,0,0,0" ToolTip="{Binding LockTooltip}" Visibility="{Binding IsBlocked, Converter={StaticResource Visible}}" />
                <Grid Grid.Column="1" Width="32" Height="32" HorizontalAlignment="Left">
                    <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border CornerRadius="8" Background="#26FFFFFF" Visibility="{Binding Icon, Converter={StaticResource Hidden}}">
                        <TextBlock Text="&#xE71D;" Style="{StaticResource IconText}" FontSize="16" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="2" Margin="4,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="{Binding NameMaxWidth}"
                                   ToolTip="{Binding Name}" />
                        <Border CornerRadius="7" Background="#334CD964" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsStore, Converter={StaticResource Visible}}">
                            <TextBlock Text="Store" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}" />
                        </Border>
                        <Border CornerRadius="7" Background="#33FFFFFF" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsSystemPublisher, Converter={StaticResource Visible}}">
                            <TextBlock Text="Microsoft" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Tab "Ứng dụng" -->
        <Grid x:Name="AppsTab">
            <!-- Chờ -->
            <Grid x:Name="IdlePanel" Margin="24,48,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="IdleIcon" Style="{StaticResource IconText}" FontSize="64" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="IdleTitle" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="IdleSubtitle" Style="{StaticResource SecondaryBodyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="500" Margin="0,8,0,0" />
                </StackPanel>
                <WrapPanel x:Name="IdleChips" Grid.Row="2" HorizontalAlignment="Center" MaxWidth="640" Margin="0,24,0,0" />
                <Button x:Name="ScanButton" Grid.Row="4" Style="{StaticResource BigActionButton}" Click="OnScan" IsDefault="True">
                    <TextBlock x:Name="ScanButtonText" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Foreground="White" />
                </Button>
            </Grid>

            <!-- Đang tìm app -->
            <Grid x:Name="LoadingPanel" Margin="24,48,24,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <ui:ProgressRing x:Name="LoadRing" Grid.Row="1" Width="170" Height="170" LineWidth="12" />
                <TextBlock x:Name="LoadText" Grid.Row="2" Style="{StaticResource HeadlineText}" HorizontalAlignment="Center" Margin="0,24,0,0" />
                <Button x:Name="LoadStop" Grid.Row="4" Style="{StaticResource GlassButton}" HorizontalAlignment="Center" Click="OnStopLoading" IsCancel="True" />
            </Grid>

            <!-- Duyệt: danh sách app + chi tiết -->
            <Grid x:Name="BrowsePanel" Margin="24,58,24,20" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cột trái: danh sách app -->
                <Border Style="{StaticResource Panel}" Padding="8">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,2,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="30,6,8,6" TextChanged="OnSearchChanged" />
                                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource SecondaryText}"
                                           HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                                <TextBlock x:Name="SearchPlaceholder" FontSize="13" Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center"
                                           Margin="33,0,0,0" IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="FilterButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="40" Height="32" Margin="6,0,0,0" Click="OnFilterMenu">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;" Style="{StaticResource IconText}" FontSize="14" />
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="8" Margin="4,1,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <DockPanel DockPanel.Dock="Top" Margin="8,10,6,6">
                            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" Click="OnReload"
                                    Foreground="{StaticResource SecondaryText}">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource SecondaryText}" />
                            </Button>
                            <Button x:Name="DeselectButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Click="OnDeselect">
                                <TextBlock x:Name="DeselectText" FontSize="12" Foreground="{StaticResource SecondaryText}" />
                            </Button>
                            <CheckBox x:Name="SelectAllApps" Style="{StaticResource TriCheck}" IsThreeState="False" Click="OnSelectAllApps"
                                      Foreground="{StaticResource SecondaryText}" FontSize="12" />
                            <TextBlock x:Name="ListCaption" FontSize="12" Foreground="{StaticResource TertiaryText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="AppList" Style="{StaticResource PlainListBox}" ItemTemplate="{StaticResource AppRowTemplate}" Margin="0,0,0,0"
                                     SelectionChanged="OnAppFocused" VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ContextMenu>
                                    <ContextMenu Opened="OnAppMenuOpened">
                                        <MenuItem x:Name="AppMenuReveal" Click="OnRevealApp" />
                                        <MenuItem x:Name="AppMenuSettings" Click="OnOpenWindowsSettings" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <TextBlock x:Name="EmptyList" Style="{StaticResource SecondaryBodyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Cột phải: chi tiết app -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="18,16,18,14">
                    <DockPanel>
                        <Grid x:Name="DetailHeader" DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="52" Height="52" VerticalAlignment="Top" Margin="0,2,14,0">
                                <Image x:Name="DetailIcon" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border x:Name="DetailIconFallback" CornerRadius="12" Background="#26FFFFFF">
                                    <TextBlock Text="&#xE71D;" Style="{StaticResource IconText}" FontSize="24" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" Style="{StaticResource TitleText}" FontSize="24" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailLine" FontSize="12" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                <DockPanel x:Name="DetailLocationRow" Margin="0,3,0,0">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource TertiaryText}" Margin="0,1,6,0" />
                                    <TextBlock x:Name="DetailLocation" FontSize="11.5" Foreground="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,4,0,0">
                                <Button x:Name="RevealButton" Style="{StaticResource GlassButton}" Padding="11,7" Click="OnRevealFocused">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="Banners" DockPanel.Dock="Top" />

                        <!-- Chân trang -->
                        <DockPanel x:Name="DetailFooter" DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Button x:Name="UninstallButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="OnUninstall" IsDefault="True" VerticalAlignment="Center" />
                            <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Margin="0,0,10,0" Padding="16,8" Click="OnReset" VerticalAlignment="Center" />
                            <Border x:Name="DryRunPill" DockPanel.Dock="Right" Style="{StaticResource PillBorder}" Background="#40FFCC00" Margin="0,0,12,0">
                                <TextBlock Text="DRY RUN" Style="{StaticResource PillText}" Foreground="{StaticResource ReviewBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="FooterTitle" Style="{StaticResource HeadlineText}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="FooterCaption" Style="{StaticResource TertiaryCaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Thân -->
                        <Grid>
                            <StackPanel x:Name="LeftoversLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock x:Name="LeftoversSpinner" Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,10,0"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotation" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="LeftoversLoadingText" Style="{StaticResource SecondaryBodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="NoFocus" Style="{StaticResource SecondaryBodyText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            <DockPanel x:Name="LeftoversView" Visibility="Collapsed" Margin="0,14,0,0">
                                <UniformGrid x:Name="Tiles" DockPanel.Dock="Top" Columns="3" />
                                <TextBlock x:Name="LeftoverCaption" DockPanel.Dock="Top" Style="{StaticResource TertiaryCaptionText}" TextWrapping="Wrap" Margin="0,12,0,8" />
                                <CheckBox x:Name="SelectAllLeftovers" DockPanel.Dock="Top" Style="{StaticResource TriCheck}" IsThreeState="False" Margin="4,0,0,6"
                                          Click="OnSelectAllLeftovers" Foreground="{StaticResource SecondaryText}" FontSize="12.5" />
                                <Grid>
                                    <shared:NodeOutlineView x:Name="Outline" />
                                    <StackPanel x:Name="NoLeftovers" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource SafeBrush}" />
                                        <TextBlock x:Name="NoLeftoversText" Style="{StaticResource SecondaryBodyText}" TextAlignment="Center" MaxWidth="380" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Xác nhận -->
            <Grid x:Name="ConfirmPanel" Margin="24,58,24,20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center" MaxWidth="680">
                    <Grid x:Name="ConfirmIcons" HorizontalAlignment="Center" Height="56" />
                    <TextBlock x:Name="ConfirmTitle" Style="{StaticResource TitleText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock x:Name="ConfirmSubtitle" Style="{StaticResource SecondaryBodyText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock x:Name="ConfirmNote" Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource ReviewBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" MaxWidth="680">
                    <StackPanel x:Name="ConfirmCards" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,8">
                    <Button x:Name="ConfirmCancel" Style="{StaticResource GlassButton}" Padding="18,8" Click="OnConfirmCancel" IsCancel="True" Margin="0,0,12,0" />
                    <Button x:Name="ConfirmOk" Style="{StaticResource PrimaryButton}" Click="OnConfirm" IsDefault="True" />
                </StackPanel>
            </Grid>

            <!-- Đang chạy trình gỡ / đang dọn -->
            <Grid x:Name="WorkingPanel" Margin="24,58,24,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <ui:ProgressRing x:Name="WorkRing" Grid.Row="1" Width="170" Height="170" LineWidth="12" />
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock x:Name="WorkTitleText" Style="{StaticResource HeadlineText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="560" TextWrapping="Wrap" />
                    <TextBlock x:Name="WorkItemText" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" Margin="0,6,0,0" />
                    <TextBlock x:Name="WorkHint" Style="{StaticResource TertiaryCaptionText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" Margin="0,10,0,0" />
                </StackPanel>
                <Button x:Name="StopWaitingButton" Grid.Row="4" Style="{StaticResource GlassButton}" HorizontalAlignment="Center" Click="OnStopWaiting" />
            </Grid>

            <!-- Xem lại file sót sau khi gỡ -->
            <Grid x:Name="ReviewPanel" Margin="24,58,24,20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE930;" Style="{StaticResource IconText}" FontSize="34" Foreground="{StaticResource SafeBrush}" Margin="2,0,14,0" />
                    <StackPanel>
                        <TextBlock x:Name="ReviewTitle" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ReviewSubtitle" Style="{StaticResource SecondaryBodyText}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock x:Name="ReviewCaption" DockPanel.Dock="Top" Style="{StaticResource TertiaryCaptionText}" TextWrapping="Wrap" Margin="4,0,4,8" />
                        <CheckBox x:Name="ReviewSelectAll" DockPanel.Dock="Top" Style="{StaticResource TriCheck}" IsThreeState="False" Margin="4,0,0,6"
                                  Click="OnReviewSelectAll" Foreground="{StaticResource SecondaryText}" FontSize="12.5" />
                        <shared:NodeOutlineView x:Name="ReviewOutline" />
                    </DockPanel>
                </Border>
                <DockPanel Grid.Row="2" Margin="0,16,0,0">
                    <Button x:Name="ReviewClean" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="OnReviewClean" IsDefault="True" VerticalAlignment="Center" />
                    <Button x:Name="ReviewSkip" DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Padding="16,8" Margin="0,0,10,0" Click="OnReviewSkip" VerticalAlignment="Center" />
                    <Border x:Name="ReviewDryRun" DockPanel.Dock="Right" Style="{StaticResource PillBorder}" Background="#40FFCC00" Margin="0,0,12,0">
                        <TextBlock Text="DRY RUN" Style="{StaticResource PillText}" Foreground="{StaticResource ReviewBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ReviewSelected" Style="{StaticResource HeadlineText}" FontSize="17" />
                        <TextBlock x:Name="ReviewSelectedDetail" Style="{StaticResource TertiaryCaptionText}" />
                        <TextBlock x:Name="ReviewPermanent" FontSize="11.5" Foreground="{StaticResource ReviewBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Xong -->
            <Grid x:Name="DonePanel" Margin="24,58,24,24" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                        <TextBlock x:Name="DoneIcon" Style="{StaticResource IconText}" FontSize="64" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DoneTitle" Style="{StaticResource TitleText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640"
                                   Margin="0,14,0,10" />
                        <Border x:Name="DoneFailBanner" CornerRadius="10" Background="{StaticResource BannerBackground}" Padding="12,9" Margin="0,8,0,0" MaxWidth="600">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource ReviewBrush}" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock x:Name="DoneFailText" Style="{StaticResource BodyText}" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="DoneInUseBanner" CornerRadius="10" Background="{StaticResource BannerBackground}" Padding="12,9" Margin="0,10,0,0" MaxWidth="600">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE785;" Style="{StaticResource IconText}" Foreground="{StaticResource ReviewBrush}" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock x:Name="DoneInUseText" Style="{StaticResource BodyText}" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="DoneFailures" Style="{StaticResource Card}" Padding="10" Margin="0,12,0,0" MaxWidth="600">
                            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DoneFailureList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3">
                                                <TextBlock Text="{Binding Item1}" FontSize="12.5" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Item2}" FontSize="11" Foreground="{StaticResource RiskyBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button x:Name="DoneSettings" Style="{StaticResource GlassButton}" Padding="16,8" Margin="0,0,12,0" Click="OnOpenWindowsSettings" />
                            <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Click="OnDone" IsDefault="True" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Tab "File sót của app đã gỡ": luồng quét/dọn chung -->
        <shared:FeatureFlowView x:Name="OrphansFlow" Margin="0,34,0,0" Visibility="Collapsed" />

        <!-- Điều khiển phân đoạn -->
        <Border x:Name="Segments" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" CornerRadius="9" Background="#26FFFFFF" MinWidth="380"
                BorderBrush="#26FFFFFF" BorderThickness="1" Padding="3">
            <UniformGrid Columns="2">
                <RadioButton x:Name="AppsSegment" Style="{StaticResource SegmentButton}" GroupName="uninstallerTab" IsChecked="True" Checked="OnTabChanged" />
                <RadioButton x:Name="OrphansSegment" Style="{StaticResource SegmentButton}" GroupName="uninstallerTab" Checked="OnTabChanged" />
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
