<Window x:Class="CleanBoost.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CleanBoost.App.UI"
        Title="Clean Boost" Width="1180" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#1E1E2A" FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Frame">
        <!-- Hai lớp nền gradient để chuyển màu mượt khi đổi tính năng -->
        <Border x:Name="BackgroundA" />
        <Border x:Name="BackgroundB" Opacity="0" />

        <Grid Panel.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Thanh bên nổi -->
            <Border x:Name="Sidebar" Margin="12,12,0,12" CornerRadius="14" WindowChrome.IsHitTestVisibleInChrome="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,14,14">
                        <Image Source="/Assets/AppIcon64.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Clean Boost" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SidebarText}" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SidebarDivider}" BorderThickness="0,1,0,0" Padding="16,12,14,14">
                        <StackPanel>
                            <TextBlock x:Name="AdminNotice" FontSize="11.5" Foreground="#E08A00" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                            <StackPanel x:Name="DryRunNotice" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#E08A00" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="DryRunText" FontSize="11.5" Foreground="#E08A00" />
                            </StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnSettings"
                                        Foreground="{DynamicResource SidebarText}">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                                <Button x:Name="LanguageButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="OnLanguage"
                                        Foreground="{DynamicResource SidebarText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="LanguageText" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" VerticalAlignment="Center" Margin="5,1,0,0" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <TextBlock x:Name="VolumeName" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" />
                            <ProgressBar x:Name="VolumeBar" Style="{StaticResource ThinProgress}" Maximum="1" Margin="0,6,0,6" Background="{DynamicResource SidebarDivider}" />
                            <TextBlock x:Name="VolumeText" FontSize="11" Foreground="{DynamicResource SidebarSecondaryText}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavItems" Margin="10,4,10,10" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Vùng chi tiết: giữ sống mọi màn đã mở để kết quả quét không mất khi chuyển màn -->
            <Grid x:Name="DetailHost" Grid.Column="1" Margin="0,28,0,0" />
        </Grid>

        <!-- Nút tiêu đề -->
        <StackPanel Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" Content="&#xE921;" />
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximize" Content="&#xE922;" />
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="OnClose" Content="&#xE8BB;" />
        </StackPanel>
    </Grid>
</Window>
